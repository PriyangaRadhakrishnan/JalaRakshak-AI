# ==============================================================================
# JalaRakshak AI — Git Ignore Rules
# ==============================================================================

# Python Environments & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js, Vite & Frontend Bundles
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
dist/
.vite/
frontend/.vite/
.vite-temp/
frontend/.vite-temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# SQLite & Local Database Files
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
backend/database/*.db
backend/database/*.db-wal
backend/database/*.db-shm
backend/database/*.db-journal

# Environment, Secret & Local Config Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
backend/.env
!*.env.example

# IDE, OS & Editor Artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
